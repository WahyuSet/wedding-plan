PORT=5000
NODE_ENV="development"

# SQLite. Di production arahkan ke persistent volume, mis. "file:/data/wedding.db"
DATABASE_URL="file:./dev.db"

# WAJIB. Minimal 32 karakter di production. Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="ganti_dengan_random_secret_panjang_minimal_32_karakter_untuk_production"

# URL frontend (untuk CORS dan tautan share) dan origin tambahan (dipisah koma)
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# URL publik backend (dipakai untuk URL file upload dan tautan share)
API_PUBLIC_URL="http://localhost:5000"

# Lokasi file upload foto/musik. Di production arahkan ke persistent volume, mis. "/data/uploads"
UPLOAD_DIR="./uploads"

# Isi jika frontend dan API berbeda subdomain tapi satu domain induk, mis. ".contoh.id"
# COOKIE_DOMAIN=".contoh.id"

# Domain khusus undangan digital, dilayani backend ini (dibedakan dari header Host).
# Hanya origin, tanpa path. Hostname harus berbeda dari FRONTEND_URL dan API_PUBLIC_URL.
# Kosongkan (biarkan dikomentari) agar undangan tetap dibuka di FRONTEND_URL/invitation/...
# Uji lokal: jalankan `npm run build` di folder frontend, lalu buka http://undangan.localhost:5000/<slug>
# INVITATION_URL="http://undangan.localhost:5000"
# Folder build frontend yang berisi index.html. Di image Docker: /app/web
# INVITATION_DIST_DIR="../frontend/dist"

# Seed (npm run seed). Di production ADMIN_PASSWORD wajib (min 12 karakter).
# Jika kosong di development, password acak dibuat dan ditampilkan sekali.
ADMIN_EMAIL="admin@weddingplan.id"
# ADMIN_PASSWORD=""
